    <!-- BLOCK 11: PICTURE-IN-PICTURE (PIP) & ADB -->
    <string name="menu_pip_name">Obraz w obrazie (PiP)</string>
    <string name="menu_pip_start">W tle (PiP)</string>
    <string name="pip_progress_format">Postęp druku: %1$d%%</string>
    <string name="btn_pip_close">Zamknij</string>
