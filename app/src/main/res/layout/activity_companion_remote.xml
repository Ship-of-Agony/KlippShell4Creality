<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:padding="6dp"
    tools:ignore="MergeRootFrame">

    <View
        android:id="@+id/remoteOuterChassis"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_remote_chassis_3d"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoteEstop"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:gravity="center"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:elevation="6dp"
        android:foreground="@drawable/fg_button_3d_gloss"
        app:icon="@drawable/report_off_24"
        app:iconSize="22dp"
        app:iconTint="#FFFFFF"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:backgroundTint="#C62828"
        app:cornerRadius="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/etTargetTvIp"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_pill_input"
        android:backgroundTint="#66000000"
        android:hint="TV IP"
        android:inputType="text"
        android:digits="0123456789."
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textColorHint="#99FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btnRemoteEstop"
        app:layout_constraintEnd_toStartOf="@+id/btnSearchTv"
        app:layout_constraintStart_toEndOf="@+id/btnRemoteEstop"
        app:layout_constraintTop_toTopOf="@+id/btnRemoteEstop" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSearchTv"
        style="@style/Widget.Material3.Button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:elevation="6dp"
        android:foreground="@drawable/fg_button_3d_gloss"
        app:icon="@drawable/broadcast_on_home_24"
        app:iconSize="20dp"
        app:iconTint="#FFFFFF"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:backgroundTint="#1565C0"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnRemoteEstop"
        app:layout_constraintEnd_toStartOf="@+id/btnLeaveRemote"
        app:layout_constraintStart_toEndOf="@+id/etTargetTvIp"
        app:layout_constraintTop_toTopOf="@+id/btnRemoteEstop" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLeaveRemote"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:elevation="6dp"
        android:foreground="@drawable/fg_button_3d_gloss"
        app:icon="@drawable/mobile_hand_off_24"
        app:iconSize="20dp"
        app:iconTint="#FF5252"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:backgroundTint="#40000000"
        app:cornerRadius="24dp"
        app:strokeWidth="2dp"
        app:strokeColor="#FF5252"
        app:layout_constraintBottom_toBottomOf="@+id/btnRemoteEstop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnRemoteEstop" />

    <TextView
        android:id="@+id/tvRemoteStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/remote_status_disconnected"
        android:textColor="#4CAF50"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etTargetTvIp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoteBackGlobal"
        android:layout_width="58dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:elevation="6dp"
        android:foreground="@drawable/fg_button_3d_gloss"
        android:text="←"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#1565C0"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/morphingFrameContainer"
        app:layout_constraintEnd_toStartOf="@+id/morphingFrameContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/morphingFrameContainer"
        app:layout_constraintVertical_bias="0.5" />

    <FrameLayout
        android:id="@+id/morphingFrameContainer"
        android:layout_width="0dp"
        android:layout_height="192dp"
        android:layout_marginTop="14dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvRemoteStatus"
        app:layout_constraintWidth_percent="0.62">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutDpadZone"
            android:layout_width="184dp"
            android:layout_height="184dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_dpad_3d"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoteOk"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:text="OK"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:gravity="center"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:elevation="8dp"
                android:foreground="@drawable/fg_button_3d_gloss"
                app:backgroundTint="#22252A"
                app:strokeWidth="2dp"
                app:strokeColor="#0E1012"
                app:cornerRadius="36dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoteUp"
                android:layout_width="52dp"
                android:layout_height="40dp"
                android:text="▲"
                android:textColor="#CCFFFFFF"
                android:textSize="18sp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="#00000000"
                app:cornerRadius="20dp"
                app:layout_constraintBottom_toTopOf="@+id/btnRemoteOk"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoteDown"
                android:layout_width="52dp"
                android:layout_height="40dp"
                android:text="▼"
                android:textColor="#CCFFFFFF"
                android:textSize="18sp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="#00000000"
                app:cornerRadius="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnRemoteOk" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoteLeft"
                android:layout_width="40dp"
                android:layout_height="52dp"
                android:text="◀"
                android:textColor="#CCFFFFFF"
                android:textSize="18sp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="#00000000"
                app:cornerRadius="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btnRemoteOk"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoteRight"
                android:layout_width="40dp"
                android:layout_height="52dp"
                android:text="▶"
                android:textColor="#CCFFFFFF"
                android:textSize="18sp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="#00000000"
                app:cornerRadius="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/btnRemoteOk"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:id="@+id/layoutTouchZone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/viewTouchPadField"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/touchme"
                android:tint="#808080"
                android:scaleType="fitCenter"
                android:padding="90dp"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="UseAppTint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical"
                android:weightSum="3">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTouchBack"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.1"
                    android:layout_marginEnd="4dp"
                    android:foreground="@drawable/fg_button_3d_gloss"
                    android:text="←"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#1565C0"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTouchReturnDpad"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.8"
                    android:layout_marginEnd="4dp"
                    android:layout_marginStart="4dp"
                    android:foreground="@drawable/fg_button_3d_gloss"
                    android:text="✥"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#C62828"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTouchOk"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.1"
                    android:layout_marginStart="4dp"
                    android:foreground="@drawable/fg_button_3d_gloss"
                    android:text="ok"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#2E7D32"
                    app:cornerRadius="24dp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleTouchMode"
        android:layout_width="58dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:elevation="6dp"
        android:foreground="@drawable/fg_button_3d_gloss"
        app:icon="@drawable/ic_trackpad_mouse"
        app:iconSize="19dp"
        app:iconTint="#FFFFFF"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:backgroundTint="#1565C0"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/morphingFrameContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/morphingFrameContainer"
        app:layout_constraintTop_toTopOf="@+id/morphingFrameContainer"
        app:layout_constraintVertical_bias="0.5" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoteStream"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="6dp"
        android:gravity="center"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:elevation="6dp"
        android:foreground="@drawable/fg_button_3d_gloss"
        app:icon="@drawable/media_link_24"
        app:iconSize="20dp"
        app:iconTint="#FFFFFF"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:backgroundTint="#1565C0"
        app:cornerRadius="21dp"
        app:layout_constraintEnd_toStartOf="@+id/btnRemoteWebMenu"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/morphingFrameContainer" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoteWebMenu"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:gravity="center"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:elevation="6dp"
        android:foreground="@drawable/fg_button_3d_gloss"
        app:icon="@drawable/dot"
        app:iconSize="18dp"
        app:iconTint="#FFFFFF"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:backgroundTint="#1565C0"
        app:cornerRadius="21dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnRemoteStream"
        app:layout_constraintEnd_toStartOf="@+id/btnRemoteLayout"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/btnRemoteStream"
        app:layout_constraintTop_toTopOf="@+id/btnRemoteStream" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoteLayout"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:elevation="6dp"
        android:foreground="@drawable/fg_button_3d_gloss"
        app:icon="@drawable/picture_in_picture_alt_24"
        app:iconSize="20dp"
        app:iconTint="#FFFFFF"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:backgroundTint="#1565C0"
        app:cornerRadius="21dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnRemoteStream"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/btnRemoteWebMenu"
        app:layout_constraintTop_toTopOf="@+id/btnRemoteStream" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoteBar"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="6dp"
        android:gravity="center"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:elevation="6dp"
        android:foreground="@drawable/fg_button_3d_gloss"
        app:icon="@drawable/credit_card_24"
        app:iconSize="18dp"
        app:iconTint="#FFFFFF"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:backgroundTint="#323741"
        app:cornerRadius="21dp"
        app:layout_constraintEnd_toStartOf="@+id/btnRemotePip"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnRemoteStream" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemotePip"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:gravity="center"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:elevation="6dp"
        android:foreground="@drawable/fg_button_3d_gloss"
        app:icon="@drawable/subtitles_24"
        app:iconSize="18dp"
        app:iconTint="#FFFFFF"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:backgroundTint="#323741"
        app:cornerRadius="21dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnRemoteBar"
        app:layout_constraintEnd_toStartOf="@+id/btnRemoteBox"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/btnRemoteBar"
        app:layout_constraintTop_toTopOf="@+id/btnRemoteBar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoteBox"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:elevation="6dp"
        android:foreground="@drawable/fg_button_3d_gloss"
        app:icon="@drawable/view_compact_alt_24"
        app:iconSize="18dp"
        app:iconTint="#FFFFFF"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:backgroundTint="#2E7D32"
        app:cornerRadius="21dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnRemoteBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/btnRemotePip"
        app:layout_constraintTop_toTopOf="@+id/btnRemoteBar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoteZoomIn"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:elevation="6dp"
        android:foreground="@drawable/fg_button_3d_gloss"
        app:icon="@drawable/zoom_out_24"
        app:iconSize="18dp"
        app:iconTint="#FFFFFF"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:backgroundTint="#2B2F37"
        app:cornerRadius="21dp"
        app:layout_constraintBottom_toTopOf="@+id/btnRemoteHome"
        app:layout_constraintEnd_toStartOf="@+id/secDpadContainer"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/secDpadContainer"
        app:layout_constraintVertical_chainStyle="packed" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoteHome"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:elevation="6dp"
        android:foreground="@drawable/fg_button_3d_gloss"
        app:icon="@drawable/home_app_logo_24"
        app:iconSize="20dp"
        app:iconTint="#FFFFFF"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:backgroundTint="#C62828"
        app:cornerRadius="21dp"
        app:layout_constraintBottom_toBottomOf="@+id/secDpadContainer"
        app:layout_constraintEnd_toEndOf="@+id/btnRemoteZoomIn"
        app:layout_constraintStart_toStartOf="@+id/btnRemoteZoomIn"
        app:layout_constraintTop_toBottomOf="@+id/btnRemoteZoomIn" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/secDpadContainer"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dpad_3d"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tvFooterInfo"
        app:layout_constraintEnd_toStartOf="@+id/btnRemoteZoomOut"
        app:layout_constraintStart_toEndOf="@+id/btnRemoteZoomIn"
        app:layout_constraintTop_toBottomOf="@+id/btnRemoteBar">

        <TextView
            android:id="@+id/tvSecDpadCenterLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OSD"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemoteSecUp"
            android:layout_width="32dp"
            android:layout_height="26dp"
            android:text="▲"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:gravity="center"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#00000000"
