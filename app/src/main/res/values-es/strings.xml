    <!-- BLOCK 14: DATENSCHUTZ- & ERSTEINRICHTUNGS-RATIONALE -->
    <string name="perm_dialog_title">Red y privacidad</string>
    <string name="perm_dialog_msg">KlippShell requiere acceso a la red para establecer una conexión directa con la API de Moonraker de tu impresora, así como permiso de notificaciones para enviarte alertas críticas e hitos de impresión (por ejemplo, impresión finalizada o error) mientras ves la televisión o usas otras aplicaciones. Se requiere conexión a Internet para comprobar actualizaciones OTA, proporcionar recursos de estado para Android TV Launcher y funciones avanzadas de acompañamiento. La seguridad de los datos es nuestra máxima prioridad: la comunicación se realiza exclusivamente de forma local entre tu dispositivo y la impresora. No se transmiten datos de control ni telemetría a servidores externos.</string>
    <string name="perm_dialog_btn">Entendido</string>
    <string name="perm_dialog_btn_decline">Rechazar y salir</string>

