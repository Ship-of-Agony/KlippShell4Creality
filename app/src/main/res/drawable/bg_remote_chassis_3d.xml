<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Äußerer Schatten -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="44dp" />
            <solid android:color="#40000000" />
            <padding android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="4dp" />
        </shape>
    </item>

    <!-- Dunkle Außenkante -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="44dp" />
            <solid android:color="#121417" />
        </shape>
    </item>

    <!-- Stärker transparente, dunklere Fläche (ca. 62% Deckkraft -> Benchy deutlich sichtbar) -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="42dp" />
            <gradient
                android:angle="270"
                android:startColor="#9E23272D"
                android:centerColor="#9E191C20"
                android:endColor="#9E101215" />
            <stroke
                android:width="1dp"
                android:color="#30FFFFFF" />
        </shape>
    </item>
</layer-list>