    <!-- BLOCK 11: PICTURE-IN-PICTURE (PIP) & ADB -->
    <string name="menu_pip_name">Obraz v obraze (PiP)</string>
    <string name="menu_pip_start">Na pozadí (PiP)</string>
    <string name="pip_progress_format">Průběh tisku: %1$d%%</string>
